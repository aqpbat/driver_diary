{
    // Запуск из VS Code: панель «Run and Debug» (⇧⌘D) → выбрать конфигурацию → F5.
    // Клиенту нужен работающий API: `docker compose up --build` в корне
    // репозитория или конфигурация «API: сервер (Go)» ниже. Конфигурации
    // с пометкой «Railway» ходят в развёрнутый сервер и локального не требуют.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Chrome -> local API",
            "type": "dart",
            "request": "launch",
            "cwd": "mobile",
            "program": "lib/main.dart",
            "deviceId": "chrome",
            "flutterMode": "debug",
            "toolArgs": [
                "--dart-define=API_BASE_URL=http://localhost:8080"
            ]
        },
        {
            // Эмулятор видит машину разработчика по адресу 10.0.2.2.
            "name": "Android (emu) -> local API",
            "type": "dart",
            "request": "launch",
            "cwd": "mobile",
            "program": "lib/main.dart",
            "flutterMode": "debug",
            "toolArgs": [
                "--dart-define=API_BASE_URL=http://10.0.2.2:8080"
            ]
        },
        {
            // Устройство — то, что выбрано в строке состояния VS Code.
            "name": "iOS (sim) -> local API",
            "type": "dart",
            "request": "launch",
            "cwd": "mobile",
            "program": "lib/main.dart",
            "flutterMode": "debug",
            "toolArgs": [
                "--dart-define=API_BASE_URL=http://localhost:8080"
            ]
        },
        {
            "name": "Chrome -> Railway",
            "type": "dart",
            "request": "launch",
            "cwd": "mobile",
            "program": "lib/main.dart",
            "deviceId": "chrome",
            "flutterMode": "debug",
            "toolArgs": [
                "--dart-define=API_BASE_URL=https://api-production-ab4d.up.railway.app"
            ]
        },
        {
            // Подходит и для настоящего телефона: локальный сервер ему не виден.
            "name": "Chosen -> Railway",
            "type": "dart",
            "request": "launch",
            "cwd": "mobile",
            "program": "lib/main.dart",
            "flutterMode": "debug",
            "toolArgs": [
                "--dart-define=API_BASE_URL=https://api-production-ab4d.up.railway.app"
            ]
        },
        {
            "name": "API: сервер (Go)",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/api/cmd/server",
            "cwd": "${workspaceFolder}/api",
            "env": {
                "DATABASE_URL": "postgres://diary:diary@localhost:5432/diary?sslmode=disable",
                "CORS_ALLOWED_ORIGINS": "*"
            }
        }
    ]
}